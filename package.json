{
  "name": "@lukman-ss/moke-core",
  "version": "0.1.16",
  "description": "Core module for Moke web framework. Provides IoC Container, Dependency Injection, and Application Bootstrap.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@12.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukman-ss/moke-core.git"
  },
  "homepage": "https://github.com/lukman-ss/moke-core#readme",
  "bugs": {
    "url": "https://github.com/lukman-ss/moke-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "core",
    "framework",
    "ioc",
    "di",
    "dependency-injection"
  ],
  "author": "lukman-ss",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "test": "cross-env TS_NODE_PROJECT=tsconfig.test.json mocha --loader=ts-node/esm \"test/**/*.test.ts\"",
    "test:watch": "cross-env TS_NODE_PROJECT=tsconfig.test.json mocha --loader=ts-node/esm --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
